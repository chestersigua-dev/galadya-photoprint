APP_NAME="Galadya Photoprint"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Manila"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# DATABASE CONNECTION
# --------------------------------------------------------------------------
# For MySQL 8.0+ / MariaDB 10.5+ (Recommended for Production / Shared Studio Server):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=galadya_photoprint
# DB_USERNAME=root
# DB_PASSWORD=

# For standalone portable terminal testing:
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@galadyastudio.ph"
MAIL_FROM_NAME="${APP_NAME}"

# Studio Printing Defaults
STUDIO_PRINT_DPI=300
STUDIO_CANVAS_WIDTH=1200
STUDIO_CANVAS_HEIGHT=1800
STUDIO_MARGIN_PX=10
